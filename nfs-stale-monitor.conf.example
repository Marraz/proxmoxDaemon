# /etc/nfs-stale-monitor/nfs-stale-monitor.conf
#
# Configuration for nfs-stale-monitor. Sourced by the daemon, so each line is a
# plain shell variable assignment. Restart the service after editing:
#
#     systemctl restart nfs-stale-monitor

# How often (seconds) to run a full check / recover pass. This is the schedule.
INTERVAL=300

# How long (seconds) a single mount probe may block before the mount is
# declared hung. Healthy mounts return in milliseconds; a value of 10 is plenty.
STAT_TIMEOUT=10

# How long (seconds) the forced/lazy umount of a stale mount may block before
# giving up.
UMOUNT_TIMEOUT=15

# How long (seconds) to wait/poll after re-enabling a storage to confirm it
# re-mounted. Proxmox usually re-mounts within a second or two.
RECOVER_SETTLE=5

# How long (seconds) a single `pvesm set` may block before giving up.
PVE_SM_TIMEOUT=60

# Proxmox storage config, used to map a mountpoint to its storage id.
STORAGE_CFG=/etc/pve/storage.cfg
